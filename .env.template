# Discord bot configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# The bot reads ordinary message text for Lily-Core sessions, so enable
# "Message Content Intent" for the bot in the Discord Developer Portal.

# Optional out-of-tree Discord addons. Addons are disabled by default.
# Comma-separated entry-point names, for example: quiz,status
# Use * only when every installed discord_adapter.addons package should load.
DISCORD_ADDONS=
# When true, a missing or broken configured addon prevents the bot from starting.
DISCORD_ADDON_STRICT=false

# Optional: enable only after enabling "Server Members Intent" in the
# Discord Developer Portal. Improves reliable name-based member search.
DISCORD_MEMBERS_INTENT=false

# One-time migration/bootstrap fallback only. When Redis has no policy yet,
# these guild IDs are seeded once; Redis is authoritative afterward.
# Comma-separated guild IDs. Use * only for an intentional all-guild migration.
DISCORD_ADMIN_GUILD_IDS=

# Runtime Discord MCP access-policy store.
REDIS_URL=redis://redis:6379/0
# Policy mutations are privileged and disabled by default.
MCP_POLICY_WRITES_ENABLED=false
# Optional Redis key overrides and bounded audit history size.
DISCORD_POLICY_REDIS_KEY=lily:discord-adapter:access-policy:v1
DISCORD_POLICY_AUDIT_REDIS_KEY=lily:discord-adapter:access-policy:audit:v1
DISCORD_POLICY_AUDIT_MAX_ENTRIES=100

# MCP OAuth Configuration (recommended)
# Canonical public HTTPS origin. The MCP resource is derived as <origin>/mcp/.
# MCP_PUBLIC_URL and MCP_OAUTH_OWNER_TOKEN must be configured together.
MCP_PUBLIC_URL=https://lily-discord-adapter.example.com
# Owner approval secret used only on the OAuth approval page. Minimum 32 chars.
# In production this is injected from the shared Key Vault secret lily-mcp-owner-token.
MCP_OAUTH_OWNER_TOKEN=
# Persist dynamic client registrations and hashed access/refresh grants.
MCP_OAUTH_STATE=/app/data/oauth-state.json
MCP_OAUTH_ACCESS_TTL=1h
MCP_OAUTH_REFRESH_TTL=720h
MCP_OAUTH_SERVER_NAME=Discord Adapter

# Legacy compatibility only. OAuth takes precedence when MCP OAuth is configured.
# If neither OAuth nor this bearer token is configured, /mcp/ fails closed with 503.
MCP_BEARER_TOKEN=

# Optional MCP DNS-rebinding allowlists. When MCP_ALLOWED_HOSTS is empty,
# localhost is allowed and the hosted adapter FQDN is derived from DOMAIN_NAME.
# Example: lily-discord-adapter.nstut.cloud,lily-discord-adapter.nstut.cloud:*
MCP_ALLOWED_HOSTS=
# Usually empty for server-to-server MCP clients. Add browser origins only if needed.
MCP_ALLOWED_ORIGINS=

# Discord message media inspection limits.
# Defaults: 32 MiB download cap, 6 MiB direct-image cap, 20 s ffmpeg timeout.
DISCORD_MEDIA_MAX_DOWNLOAD_BYTES=33554432
DISCORD_MEDIA_MAX_DIRECT_IMAGE_BYTES=6291456
DISCORD_MEDIA_FFMPEG_TIMEOUT_SECONDS=20
# Extra HTTPS hosts allowed for embedded-media fetching. These extend the
# built-in Discord/Tenor/Giphy allowlist rather than replacing it.
DISCORD_MEDIA_ALLOWED_HOSTS=

# Message-processing concurrency and rate limits.
RATE_LIMIT_RPS=10
MAX_CONCURRENT_REQUESTS=5
BURST_LIMIT=20
MAX_CONCURRENT_MESSAGES=10
MESSAGE_QUEUE_SIZE=1000
NUM_WORKERS=4

# Service configuration
PORT=8004
# Used for service-discovery public metadata and automatic MCP host derivation.
DOMAIN_NAME=example.com

# Consul configuration
CONSUL_HTTP_ADDR=consul:8500
